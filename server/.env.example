# TrendLens Pro — Bybit Demo proxy configuration
#
# Copy this file to `.env` and fill in your Bybit DEMO TRADING credentials.
# `.env` is git-ignored and must never be committed or exposed to the browser.
#
# Create the key under Bybit > Account > API Key with the "Bybit Demo Trading"
# environment selected. Use a key that has NO IP restriction, and revoke it
# immediately if it was ever pasted into a public frontend.

# ── Bybit Demo Trading credentials (server-side only) ───────────────────────
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# ── Master switch for anything that mutates the demo account ──────────────
# false (default) = order placement, position closing and leverage changes are
#                   refused with HTTP 403 TRADING_DISABLED.
# true            = those routes are enabled (still requires the per-request
#                   confirmation header and the optional proxy token).
BYBIT_DEMO_TRADING_ENABLED=false

# ── Optional shared secret required on mutating requests ───────────────────
# If set, mutating routes must also send x-trendlens-proxy-token.
BYBIT_PROXY_TOKEN=

# ── Server binding ─────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1

# ── CORS: comma-separated list of allowed browser origins ──────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
